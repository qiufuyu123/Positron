  <!-- Minify + ship the v2 bootstrap JS next to host.exe. terser runs
       only when the source is newer than the output. The SDK reads the
       minified copy at attach time; edit sdk/bootstrap.js, rebuild, done. -->
  <Target Name="MinifyBootstrapJs" AfterTargets="Build"
          Inputs="$(SolutionDir)sdk\bootstrap.js"
          Outputs="$(OutDir)bootstrap.js">
    <Exec Command="npx terser &quot;$(SolutionDir)sdk\bootstrap.js&quot; --compress --mangle --output &quot;$(OutDir)bootstrap.js&quot;"
          WorkingDirectory="$(SolutionDir)"
          StandardOutputImportance="low" />
    <Message Text="bootstrap.js minified -> $(OutDir)bootstrap.js" Importance="high" />
  </Target>
